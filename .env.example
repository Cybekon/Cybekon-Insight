# Path to the log file to monitor.
# Example: /var/log/auth.log (Linux)
LOG_FILE_PATH=/var/log/auth.log

# Number of detected events from the same IP
# within the monitoring time window before triggering a response.
THRESHOLD=5

# Telegram Bot API token (optional).
# Leave empty to disable Telegram notifications.
TELEGRAM_TOKEN=

# Telegram chat ID for security alerts (optional).
# Leave empty to disable Telegram notifications.
CHAT_ID=